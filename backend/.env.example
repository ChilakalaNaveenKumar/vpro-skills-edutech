# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
# Host port 5433 (see docker/docker-compose.yml) - only relevant if you
# run the backend directly (not in Docker) against the Dockerized
# Postgres. Inside Docker, the backend container uses postgres:5432
# instead (see docker/docker-compose.yml's own DATABASE_URL override).
DATABASE_URL=postgresql+psycopg2://vpro:vpro_password@localhost:5433/vpro_skills

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRE_MINUTES=60

# Comma-separated list of allowed origins for the web/mobile apps
CORS_ORIGINS=http://localhost:5173,http://localhost:19006
