# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
# Host port 5433 (see docker/docker-compose.yml) - only relevant if you
# run the backend directly (not in Docker) against the Dockerized
# Postgres. Inside Docker, the backend container uses postgres:5432
# instead (see docker/docker-compose.yml's own DATABASE_URL override).
DATABASE_URL=postgresql+psycopg2://vpro:vpro_password@localhost:5433/vpro_skills

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRE_MINUTES=60

# Comma-separated list of allowed origins for the web/mobile apps
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# Shared secret for the partner API (/api/partner/*), which the DIGI SETU
# storefront reads its own batches and course copy from. Server to server, so
# there is no user to log in - one long random key in an X-Partner-Key header.
#
# Leave it EMPTY to switch the partner surface off entirely: every route under
# /api/partner then answers 503, which is what a deployment with no partner
# should do. An empty key is never accepted as a match.
#
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# In production this comes from SSM, not from this file - see docs/RUNBOOK.md.
PARTNER_API_KEY=
