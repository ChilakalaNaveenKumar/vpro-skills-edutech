# Copy this file to docker/.env before deploying with docker-compose.prod.yml.
# Never commit docker/.env - it holds real production credentials.
#
# These three values are interpolated into docker-compose.prod.yml (Compose
# reads docker/.env automatically) to override docker-compose.yml's
# hardcoded local-dev Postgres credentials. Pick a long random password -
# this is the production database, not the "vpro_password" dev default.

POSTGRES_USER=vpro
POSTGRES_PASSWORD=change-this-to-a-long-random-password
POSTGRES_DB=vpro_skills
