# Copy to terraform.tfvars and fill in before running `terraform plan`/`apply`.
# terraform.tfvars is gitignored (see ../../.gitignore) - it's fine for it
# to hold this project's non-secret configuration (nothing here is a
# password or key), but keeping it out of git avoids any confusion about
# what's "real" config vs an example.

alert_email = "you@example.com" # required - AWS Budget + instance-health alerts go here

# Everything below already has a sensible default (see variables.tf) -
# uncomment and change only what you actually want different.

# aws_region           = "us-east-1"
# instance_type        = "t3.medium"
# db_instance_class    = "db.t4g.micro"
# monthly_budget_usd   = 100
