# Python / backend
__pycache__/
*.pyc
.venv/
*.egg-info/

# Node / web + mobile
node_modules/
dist/
build/
.expo/
*.log

# Env files - never commit real secrets
.env
!.env.example

# Editors / OS
.DS_Store
.vscode/
.idea/

# Scaffolding cleanup (safe to delete)
_to_delete/

# Local database backups (docker/backup.sh output)
docker/backups/

# Platform/device-bridge scaffolding - not part of this project's source,
# generated by the sandbox environment itself. Never commit it.
docker/bridge/

# Stray pytest cache dirs from sandboxed test runs (pytest.ini already
# disables the cache plugin for normal runs; this covers leftovers from
# before that was added).
pytest-cache-files-*/
.pytest_cache/

# Terraform (infra/aws/) - state files can contain secrets/resource
# details (e.g. the RDS endpoint) and must never be committed; .terraform/
# is a large local provider-plugin cache; *.tfvars holds this
# deployment's config (nothing secret today - see
# infra/aws/terraform.tfvars.example - but keep it out of git on
# principle, same as every other real-vs-example config file here).
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# Scratch space for plan execution: task briefs, implementer reports and
# review diffs. Regenerable from the plan and git history, so it is never
# committed - but note the progress ledger lives here too, which is why
# `git clean -fdx` mid-execution loses your place.
.superpowers/
